{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-cloud",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "8cb1bf30-8a09-4c3b-a75a-533795944c8d","database_name": "web-cloud" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "668e6317aa994dd3b70c7f68d92a9901" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
